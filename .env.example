# Local development (.env.local) — copy this file to .env.local and fill in
# NEXT_PUBLIC_SITE_URL: leave blank to default to http://localhost:3000, or
# set it explicitly to override.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel preview and production — supplied by the hosting environment, never
# committed. Same names, different values per environment.
#
# NEXT_PUBLIC_SITE_URL may be left unset on Vercel: it is then derived at
# build time from Vercel's system environment (production -> the project's
# production URL, preview -> the branch/deployment URL). Set it explicitly
# here only to override that derived value.

# Server-only, secret — never prefix with NEXT_PUBLIC_, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=
